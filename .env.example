# ---------- Postgres ----------
DATABASE_URL=postgresql://incident_dash:dev_password@localhost:5432/incident_dashboard

# ---------- Google OAuth (real) ----------
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=            # generate with: openssl rand -base64 32

# Shared secret used to sign/verify the compact API token that the Next.js
# frontend forwards to the Express/WebSocket backend. Must match on both
# apps/web and apps/server.
AUTH_JWT_SECRET=            # generate with: openssl rand -base64 32

# First real Google sign-in matching this email is auto-promoted to ADMIN
# (the one deliberate exception to "roles only change via explicit Admin
# action" — still recorded in the audit log as a seed action).
SEED_ADMIN_EMAIL=you@example.com

# ---------- Server ----------
SERVER_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Used by apps/web to reach apps/server
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ---------- Connector mode toggles ----------
# "mock" (default, no credentials needed) or "real" (wires up the SDK/API
# clients below). Each source can be flipped independently.
CONNECTOR_MODE_CLOUD_LOGGING=mock
CONNECTOR_MODE_CLOUD_MONITORING=mock
CONNECTOR_MODE_CLOUD_RUN=mock
CONNECTOR_MODE_CLOUD_FUNCTIONS=mock
CONNECTOR_MODE_DATA_FUSION=mock
CONNECTOR_MODE_BIGQUERY=mock
CONNECTOR_MODE_TABLEAU_SERVER=mock

# ---------- Real-connector credentials (unused while mode=mock) ----------
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY_PATH=
TABLEAU_SERVER_URL=
TABLEAU_SITE_NAME=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=

# ---------- Mock generator tuning ----------
MOCK_GENERATOR_INTERVAL_MS=8000
